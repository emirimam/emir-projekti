# Vercel → Account Settings → Tokens (Read-only scope je dovoljan)
VERCEL_TOKEN=
# Opcionalno: ako su projekti pod timom
VERCEL_TEAM_ID=
# Projekti koje NE želiš prikazati (zarezom odvojeno, po imenu Vercel projekta)
VERCEL_EXCLUDE=emir-projekti
# Javna adresa ove stranice
SITE_URL=https://emir-projekti.vercel.app
PUBLIC_GOOGLE_SITE_VERIFICATION=
