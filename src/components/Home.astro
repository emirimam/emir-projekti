---
import Base from '../layouts/Base.astro';
import Lattice from './Lattice.astro';
import ProjectRow from './ProjectRow.astro';
import { getProjects, syncedAt, type Category } from '../lib/projects';
import { LANGS, langMeta, relativeDate, summary, ui, type Lang } from '../i18n';
import { site } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const projects = await getProjects(lang);

const count = (fn: (s: string) => boolean) => projects.filter((p) => fn(p.status)).length;
const sum = summary(
  lang,
  projects.length,
  count((s) => s === 'live'),
  count((s) => s === 'beta'),
  count((s) => s === 'u-izradi' || s === 'ideja'),
);

const categories = [...new Set(projects.map((p) => p.category))] as Category[];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t.title,
  inLanguage: langMeta[lang].locale,
  itemListElement: projects.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: p.name,
      description: p.tagline,
      applicationCategory: 'WebApplication',
      ...(p.url ? { url: p.url } : {}),
    },
  })),
};
---

<Base lang={lang}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <header class="wrap top">
    <a class="mark" href={langMeta[lang].path} aria-label={t.home}>
      <svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true"
        ><polygon points="16,3 28,10 16,17 4,10" fill="var(--cat-iznajmljivanje)" opacity=".7"></polygon><polygon
          points="4,10 16,17 16,30 4,23"
          fill="var(--cat-iznajmljivanje)"></polygon><polygon
          points="28,10 16,17 16,30 28,23"
          fill="color-mix(in oklab, var(--cat-iznajmljivanje) 70%, black)"></polygon></svg
      >
      {site.owner}
    </a>
    <div class="top-right">
      <span class="place">{t.place}</span>
      <nav class="lang" aria-label={t.langSwitch}>
        {
          LANGS.map((l) => (
            <a
              href={langMeta[l].path}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? 'true' : undefined}
              title={langMeta[l].label}
              data-lang={l}
            >
              {langMeta[l].short}
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <main>
    <section class="wrap hero" aria-labelledby="naslov">
      <div class="intro">
        <h1 id="naslov">{t.h1}</h1>
        <p class="lede">{t.lede}</p>
        <p class="count">
          <strong>{sum.count}</strong>: {sum.parts}.
        </p>
      </div>
      <Lattice projects={projects} lang={lang} />
    </section>

    <section id="projekti" class="wrap list" aria-labelledby="projekti-naslov">
      <div class="list-head">
        <h2 id="projekti-naslov">{t.projects}</h2>
        <div class="filters" role="group" aria-label={t.filterBy} hidden data-shown={t.shown(0)}>
          <button type="button" data-filter="sve" aria-pressed="true">{t.all}</button>
          {
            categories.map((c) => (
              <button type="button" data-filter={c} data-cat={c} aria-pressed="false">
                {t.category[c]}
              </button>
            ))
          }
        </div>
      </div>
      <p class="sr-only" aria-live="polite" data-announce></p>
      <ol class="rows">
        {projects.map((p) => <ProjectRow project={p} lang={lang} />)}
      </ol>
    </section>
    {
      site.email && (
        <section class="wrap contact-wrap" aria-labelledby="kontakt">
          <div class="contact">
            <div class="contact-text">
              <h2 id="kontakt">{t.contact.title}</h2>
              <p>{t.contact.text}</p>
              <div class="actions">
                <a class="btn btn--primary" href={`mailto:${site.email}`}>
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
                    ><path
                      d="M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"></path><path
                      d="m3.5 6.5 8.5 6.5 8.5-6.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linejoin="round"></path></svg
                  >
                  {t.contact.send}
                </a>
                <button type="button" class="btn btn--ghost" data-copy={site.email} data-copy-label={t.contact.copy} data-copied-label={t.contact.copied}>
                  <svg class="i-copy" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
                    ><rect x="8" y="8" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"
                    ></rect><path
                      d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"></path></svg
                  >
                  <svg class="i-done" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
                    ><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
                    ></path></svg
                  >
                  <span data-label>{t.contact.copy}</span>
                </button>
              </div>
              <p class="address">{site.email}</p>
            </div>
            <svg class="crystal" viewBox="-70 -80 140 150" aria-hidden="true">
              <g class="cube" transform="translate(-30 10)">
                <polygon points="0,-34 29,-17 0,0 -29,-17" class="t"></polygon>
                <polygon points="-29,-17 0,0 0,34 -29,17" class="l"></polygon>
                <polygon points="29,-17 0,0 0,34 29,17" class="r"></polygon>
              </g>
              <g class="cube cube--sm" transform="translate(30 -8) scale(.62)">
                <polygon points="0,-34 29,-17 0,0 -29,-17" class="t"></polygon>
                <polygon points="-29,-17 0,0 0,34 -29,17" class="l"></polygon>
                <polygon points="29,-17 0,0 0,34 29,17" class="r"></polygon>
              </g>
              <g class="cube cube--xs" transform="translate(12 -52) scale(.4)">
                <polygon points="0,-34 29,-17 0,0 -29,-17" class="t"></polygon>
                <polygon points="-29,-17 0,0 0,34 -29,17" class="l"></polygon>
                <polygon points="29,-17 0,0 0,34 29,17" class="r"></polygon>
              </g>
            </svg>
          </div>
        </section>
      )
    }
  </main>

  <footer class="wrap foot">
    <p>© {new Date().getFullYear()} {site.owner}, {t.place}</p>
    {
      syncedAt && (
        <p>
          {t.synced}{' '}
          <time datetime={syncedAt}>{relativeDate(syncedAt, lang)}</time>.
        </p>
      )
    }
  </footer>
</Base>

<script>
  const rows = [...document.querySelectorAll<HTMLElement>('.row')];
  const ions = [...document.querySelectorAll<SVGAElement>('a.ion')];
  const filters = document.querySelector<HTMLElement>('.filters');
  const announce = document.querySelector<HTMLElement>('[data-announce]');

  // Povezivanje kocke u rešetki i reda u listi
  const setActive = (id: string | null) => {
    for (const el of [...rows, ...ions]) el.classList.toggle('is-active', !!id && el.dataset.id === id);
  };
  for (const el of [...rows, ...ions]) {
    el.addEventListener('pointerenter', () => setActive(el.dataset.id ?? null));
    el.addEventListener('pointerleave', () => setActive(null));
    el.addEventListener('focusin', () => setActive(el.dataset.id ?? null));
    el.addEventListener('focusout', () => setActive(null));
  }

  // Kopiranje emaila
  for (const btn of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    if (!navigator.clipboard) {
      btn.hidden = true;
      continue;
    }
    const label = btn.querySelector<HTMLElement>('[data-label]');
    let timer: ReturnType<typeof setTimeout> | undefined;
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      btn.classList.add('is-done');
      if (label) label.textContent = btn.dataset.copiedLabel ?? '';
      clearTimeout(timer);
      timer = setTimeout(() => {
        btn.classList.remove('is-done');
        if (label) label.textContent = btn.dataset.copyLabel ?? '';
      }, 2200);
    });
  }

  // Filteri (bez JS-a se jednostavno prikazuje sve)
  if (filters) {
    filters.hidden = false;
    filters.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
      if (!btn) return;
      const value = btn.dataset.filter;
      for (const b of filters.querySelectorAll('button')) b.setAttribute('aria-pressed', String(b === btn));
      let shown = 0;
      for (const r of rows) {
        const match = value === 'sve' || r.dataset.cat === value;
        r.hidden = !match;
        if (match) shown++;
      }
      for (const i of ions) i.classList.toggle('is-dim', value !== 'sve' && i.dataset.cat !== value);
      if (announce) announce.textContent = (filters.dataset.shown ?? '').replace(/\d+$/, String(shown));
    });
  }
</script>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.5rem;
    font-size: var(--step--1);
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 650;
    font-size: var(--step-0);
  }
  .top-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .place {
    color: var(--muted);
  }
  .lang {
    display: flex;
    padding: 0.2rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .lang a {
    min-width: 2.5rem;
    min-height: 2rem;
    display: grid;
    place-items: center;
    padding: 0 0.6rem;
    border-radius: 999px;
    color: var(--muted);
    font-weight: 600;
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .lang a:hover {
    color: var(--ink);
  }
  .lang a[aria-current] {
    background: var(--ink);
    color: var(--paper);
  }
  @media (max-width: 34rem) {
    .place {
      display: none;
    }
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: 3rem;
    padding-block: clamp(2rem, 7vw, 6rem) clamp(3rem, 8vw, 7rem);
  }
  h1 {
    margin: 0;
    font-size: var(--step-4);
    line-height: 0.98;
    font-weight: 700;
    letter-spacing: -0.035em;
    font-stretch: 85%;
    max-width: 14ch;
    text-wrap: balance;
  }
  .lede {
    margin: 1.75rem 0 0;
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 36ch;
    color: var(--muted);
  }
  .count {
    margin: 1.5rem 0 0;
    max-width: 44ch;
  }

  .list {
    padding-bottom: 4rem;
  }
  .list-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-bottom: 1.25rem;
  }
  h2 {
    margin: 0;
    font-size: var(--step-3);
    letter-spacing: -0.02em;
    font-stretch: 90%;
    line-height: 1;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .filters[hidden] {
    display: none;
  }
  .filters button {
    font: inherit;
    font-size: var(--step--1);
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    min-height: 2.25rem;
  }
  .filters button:hover {
    border-color: var(--ink);
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }

  .contact-wrap {
    padding-block: 2rem 4rem;
  }
  .contact {
    --panel: #18232d;
    --panel-ink: #eef1f3;
    --panel-muted: #a9b6c0;
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem;
    padding: clamp(1.75rem, 5vw, 3.5rem);
    border-radius: 1.5rem;
    background:
      radial-gradient(60% 90% at 100% 0%, color-mix(in oklab, var(--cat-iznajmljivanje) 22%, transparent), transparent 70%),
      var(--panel);
    color: var(--panel-ink);
  }
  @media (prefers-color-scheme: dark) {
    .contact {
      --panel: #1f2c36;
      box-shadow: inset 0 0 0 1px var(--line);
    }
  }
  .contact h2 {
    font-size: clamp(1.9rem, 4.6vw, 3rem);
    line-height: 1.02;
    max-width: 16ch;
    text-wrap: balance;
  }
  .contact-text > p {
    margin: 1rem 0 0;
    max-width: 44ch;
    color: var(--panel-muted);
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0.7rem 1.35rem;
    border-radius: 999px;
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 160ms,
      border-color 160ms,
      color 160ms,
      transform 160ms;
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn:focus-visible {
    outline-color: var(--cat-iznajmljivanje);
  }
  .btn--primary {
    background: var(--cat-iznajmljivanje);
    color: #18232d;
    border: 1px solid transparent;
  }
  .btn--primary:hover {
    background: color-mix(in oklab, var(--cat-iznajmljivanje) 85%, white);
  }
  .btn--ghost {
    background: transparent;
    color: var(--panel-ink);
    border: 1px solid color-mix(in oklab, var(--panel-ink) 30%, transparent);
  }
  .btn--ghost:hover {
    border-color: var(--panel-ink);
  }
  .btn--ghost .i-done {
    display: none;
  }
  .btn--ghost.is-done {
    border-color: #4cc38a;
    color: #7fe0b0;
  }
  .btn--ghost.is-done .i-copy {
    display: none;
  }
  .btn--ghost.is-done .i-done {
    display: block;
  }
  .btn[hidden] {
    display: none;
  }
  .address {
    margin: 1rem 0 0;
    font-size: var(--step--1);
    color: var(--panel-muted);
    font-variant-numeric: tabular-nums;
    user-select: all;
  }
  .crystal {
    width: clamp(9rem, 18vw, 14rem);
    height: auto;
    margin-right: clamp(0rem, 2vw, 2rem);
  }
  .crystal .t {
    fill: color-mix(in oklab, var(--cat-iznajmljivanje) 70%, white);
  }
  .crystal .l {
    fill: var(--cat-iznajmljivanje);
  }
  .crystal .r {
    fill: color-mix(in oklab, var(--cat-iznajmljivanje) 62%, black);
  }
  .crystal .cube--sm .t {
    fill: color-mix(in oklab, var(--cat-alati) 65%, white);
  }
  .crystal .cube--sm .l {
    fill: var(--cat-alati);
  }
  .crystal .cube--sm .r {
    fill: color-mix(in oklab, var(--cat-alati) 60%, black);
  }
  .crystal .cube--xs {
    opacity: 0.55;
  }
  .crystal polygon {
    stroke: var(--panel);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem 3rem;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .foot p {
    margin: 0;
  }

  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 44rem) {
    .contact {
      grid-template-columns: 1fr;
    }
    .crystal {
      position: absolute;
      top: -1rem;
      right: -1.5rem;
      width: 7.5rem;
      opacity: 0.35;
    }
    .actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
