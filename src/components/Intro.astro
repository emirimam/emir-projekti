---
/**
 * Uvodni video preko cijelog ekrana.
 * - Prikazuje se jednom po posjeti (sessionStorage), ne za "smanji pokrete".
 * - Krene bez zvuka (pravilo preglednika); "Uključi zvuk" ga vraća na početak sa zvukom.
 * - Preskače se dugmetom, tipkom Esc ili skrolanjem; na kraju se sam skloni.
 * - Sadržaj stranice je u HTML-u ispod, pa Google i čitači ekrana vide stranicu normalno.
 * Video se pravi skriptom scripts/promo/render.py.
 */
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].intro;
---

<div class="intro" data-intro hidden role="dialog" aria-modal="true" aria-label={t.label}>
  <video
    muted
    playsinline
    preload="auto"
    poster="/video/emir-promo.jpg"
    data-sound-on={t.soundOn}
    data-sound-off={t.soundOff}>
    <source src="/video/emir-promo-720.webm" type="video/webm; codecs=vp9,opus" media="(max-width: 1280px)" />
    <source src="/video/emir-promo-720.mp4" type="video/mp4" media="(max-width: 1280px)" />
    <source src="/video/emir-promo.webm" type="video/webm; codecs=vp9,opus" />
    <source src="/video/emir-promo.mp4" type="video/mp4" />
  </video>
  <div class="bar" aria-hidden="true"><span data-progress></span></div>
  <div class="ui">
    <button type="button" class="btn" data-sound aria-pressed="false">
      <svg class="i-off" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"></path><path
          d="m16 9.5 5 5m0-5-5 5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"></path></svg
      >
      <svg class="i-on" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"></path><path
          d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"></path></svg
      >
      <span data-label>{t.soundOn}</span>
    </button>
    <button type="button" class="btn btn--skip" data-skip>
      {t.skip}
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
        ><path d="M6 5l8 7-8 7zM16 5h2.5v14H16z" fill="currentColor"></path></svg
      >
    </button>
  </div>
</div>

<script is:inline>
  // Odluči prije prvog crtanja, da stranica ne "bljesne" ispod intra
  (function () {
    const el = document.querySelector('[data-intro]');
    if (!el) return;
    let seen = false;
    try {
      seen = sessionStorage.getItem('intro-seen') === '1';
    } catch {
      /* bez pristupa sessionStorage — pokaži intro */
    }
    const reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!seen && !reduce) {
      el.hidden = false;
      document.documentElement.classList.add('intro-open');
    }
  })();
</script>

<script>
  const el = document.querySelector<HTMLElement>('[data-intro]');
  if (el) {
    const v = el.querySelector('video')!;
    const sound = el.querySelector<HTMLButtonElement>('[data-sound]')!;
    const label = sound.querySelector<HTMLElement>('[data-label]')!;
    const skip = el.querySelector<HTMLButtonElement>('[data-skip]')!;
    const bar = el.querySelector<HTMLElement>('[data-progress]')!;
    let closing = false;

    const remember = () => {
      try {
        sessionStorage.setItem('intro-seen', '1');
      } catch {
        /* privatni prozor — samo nastavi */
      }
    };
    const syncSound = () => {
      sound.setAttribute('aria-pressed', String(!v.muted));
      el.classList.toggle('has-sound', !v.muted);
      label.textContent = (v.muted ? v.dataset.soundOn : v.dataset.soundOff) ?? '';
    };
    const close = () => {
      if (closing || el.hidden) return;
      closing = true;
      remember();
      el.classList.add('is-leaving');
      document.documentElement.classList.remove('intro-open');
      const done = () => {
        el.hidden = true;
        el.classList.remove('is-leaving');
        v.pause();
        closing = false;
        document.getElementById('naslov')?.focus({ preventScroll: true });
      };
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) done();
      else setTimeout(done, 900);
    };
    const open = (withSound: boolean) => {
      el.hidden = false;
      document.documentElement.classList.add('intro-open');
      v.currentTime = 0;
      v.muted = !withSound;
      syncSound();
      v.play().catch(() => {
        v.muted = true;
        syncSound();
        v.play().catch(() => {});
      });
      skip.focus();
    };

    v.addEventListener('timeupdate', () => {
      bar.style.transform = `scaleX(${v.duration ? v.currentTime / v.duration : 0})`;
      if (v.duration && v.currentTime > v.duration - 0.6) close();
    });
    v.addEventListener('ended', close);
    v.addEventListener('volumechange', syncSound);
    sound.addEventListener('click', () => {
      if (v.muted) {
        v.muted = false;
        v.currentTime = 0; // zvuk je složen uz sliku — kreni ispočetka
        v.play().catch(() => {});
      } else v.muted = true;
      syncSound();
    });
    skip.addEventListener('click', close);
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !el.hidden) close();
    });
    addEventListener('wheel', () => !el.hidden && close(), { passive: true });
    let ty = 0;
    addEventListener('touchstart', (e) => (ty = e.touches[0].clientY), { passive: true });
    addEventListener(
      'touchmove',
      (e) => {
        if (!el.hidden && Math.abs(e.touches[0].clientY - ty) > 40) close();
      },
      { passive: true },
    );

    if (!el.hidden) {
      syncSound();
      v.play().catch(() => {
        /* autoplay odbijen — korisnik može kliknuti preskoči */
      });
      skip.focus({ preventScroll: true });
    }

    // dugme "Pogledaj intro" na stranici
    document.querySelectorAll('[data-replay-intro]').forEach((b) => b.addEventListener('click', () => open(true)));
  }
</script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: #070b0f;
    transition:
      opacity 0.8s cubic-bezier(0.7, 0, 0.2, 1),
      transform 0.8s cubic-bezier(0.7, 0, 0.2, 1),
      clip-path 0.8s cubic-bezier(0.7, 0, 0.2, 1);
    clip-path: inset(0 0 0 0 round 0);
  }
  .intro[hidden] {
    display: none;
  }
  .intro.is-leaving {
    opacity: 0;
    transform: scale(1.04);
    clip-path: inset(6% 8% 6% 8% round 2rem);
  }
  .intro video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-aspect-ratio: 4/3) {
    .intro video {
      object-fit: contain;
    }
  }
  .bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
  }
  .bar span {
    display: block;
    height: 100%;
    background: #e2a21f;
    transform-origin: left;
    transform: scaleX(0);
  }
  .ui {
    position: absolute;
    left: clamp(1rem, 3vw, 2.5rem);
    right: clamp(1rem, 3vw, 2.5rem);
    bottom: clamp(1.25rem, 4vh, 2.5rem);
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.9rem;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(10, 16, 22, 0.5);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: #eef1f3;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 160ms,
      border-color 160ms;
  }
  .btn:hover {
    background: rgba(10, 16, 22, 0.8);
    border-color: rgba(255, 255, 255, 0.5);
  }
  .btn:focus-visible {
    outline: 2px solid #e2a21f;
    outline-offset: 3px;
  }
  .i-on,
  .has-sound .i-off {
    display: none;
  }
  .has-sound .i-on {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .intro:not(.has-sound) [data-sound] {
      animation: nudge 2.4s ease-in-out 1.5s infinite;
    }
    @keyframes nudge {
      0%,
      100% {
        box-shadow: 0 0 0 0 rgba(226, 162, 31, 0);
      }
      50% {
        box-shadow: 0 0 0 7px rgba(226, 162, 31, 0.3);
      }
    }
  }
  :global(html.intro-open) {
    overflow: hidden;
  }
</style>
