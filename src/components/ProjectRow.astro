---
import type { Project } from '../lib/projects';
import { relativeDate, ui, type Lang } from '../i18n';

interface Props {
  project: Project;
  lang: Lang;
}
const { project: p, lang } = Astro.props;
const t = ui[lang];
---

<li
  id={`p-${p.id}`}
  class:list={['row', { 'row--featured': p.featured }]}
  data-id={p.id}
  data-cat={p.category}
  data-status={p.status}
>
  <div class="head">
    <span class="swatch" aria-hidden="true"></span>
    <h3>
      {p.url ? <a href={p.url} rel="noopener" target="_blank">{p.name}<span class="sr-only"> {t.newWindow}</span></a> : p.name}
    </h3>
    <p class="tagline">{p.tagline}</p>
  </div>

  <div class="body">
    {p.description && <p>{p.description}</p>}
    {p.audience && <p class="audience">{t.audience}: {p.audience}</p>}
    {p.auto && <p class="audience">{t.autoNote(p.id)}</p>}
    {
      p.video && (
        <figure class="clip">
          <video
            src={p.video.src}
            poster={p.video.poster}
            controls
            playsinline
            preload="none"
            width={p.video.width}
            height={p.video.height}
            aria-label={t.video(p.name)}
          />
          <figcaption>{t.videoNote(p.video.duration)}</figcaption>
        </figure>
      )
    }
  </div>

  <dl class="meta">
    <div>
      <dt class="sr-only">Status</dt>
      <dd><span class="status" data-status={p.status}>{p.auto ? t.status.novo : t.status[p.status]}</span></dd>
    </div>
    <div>
      <dt>{t.meta.area}</dt>
      <dd>{t.category[p.category]}</dd>
    </div>
    {
      p.stack.length > 0 && (
        <div>
          <dt>{t.meta.stack}</dt>
          <dd>{p.stack.join(', ')}</dd>
        </div>
      )
    }
    {
      p.host && (
        <div>
          <dt>{t.meta.address}</dt>
          <dd>
            <a href={p.url} rel="noopener" target="_blank">
              {p.host}
            </a>
          </dd>
        </div>
      )
    }
    {
      p.updatedAt && (
        <div>
          <dt>{t.meta.updated}</dt>
          <dd>
            <time datetime={p.updatedAt}>{relativeDate(p.updatedAt, lang)}</time>
          </dd>
        </div>
      )
    }
  </dl>
</li>

<style>
  .row {
    --c: var(--cat-ostalo);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.3fr) minmax(12rem, 0.8fr);
    gap: 1rem 2.5rem;
    padding-block: 2rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 2rem;
    transition: background-color 200ms;
  }
  .row[data-cat='iznajmljivanje'] {
    --c: var(--cat-iznajmljivanje);
  }
  .row[data-cat='alati'] {
    --c: var(--cat-alati);
  }
  .row[data-cat='turizam'] {
    --c: var(--cat-turizam);
  }
  .row[data-cat='telekom'] {
    --c: var(--cat-telekom);
  }
  .row[data-cat='transport'] {
    --c: var(--cat-transport);
  }
  .row[hidden] {
    display: none;
  }
  .row.is-active,
  .row:target {
    background: linear-gradient(90deg, color-mix(in oklab, var(--c) 14%, transparent), transparent 70%);
  }

  .head {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.85rem;
    align-content: start;
  }
  .swatch {
    width: 0.9rem;
    height: 0.9rem;
    margin-top: 0.55em;
    background: var(--c);
    transform: rotate(45deg) skew(-8deg, -8deg);
  }
  h3 {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.015em;
    font-stretch: 90%;
  }
  .row--featured h3 {
    font-size: var(--step-3);
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .tagline {
    grid-column: 2;
    margin: 0.4rem 0 0;
    color: var(--muted);
    max-width: 34ch;
  }
  .body p {
    margin: 0 0 0.75rem;
    max-width: 52ch;
  }
  .audience {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .clip {
    margin: 1.25rem 0 0;
    max-width: 52ch;
  }
  .clip video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    background: #13212e;
    box-shadow: 0 0 0 1px var(--line);
  }
  .clip figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .meta {
    margin: 0;
    display: grid;
    gap: 0.6rem;
    align-content: start;
    font-size: var(--step--1);
  }
  .meta div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.5rem;
  }
  .meta div:first-child {
    display: block;
    margin-bottom: 0.25rem;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
  }
  .status::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--muted);
  }
  .status[data-status='live']::before {
    background: #2f9e5b;
    box-shadow: 0 0 0 3px color-mix(in oklab, #2f9e5b 25%, transparent);
  }
  .status[data-status='beta']::before {
    background: var(--cat-iznajmljivanje);
  }
  .status[data-status='u-izradi']::before {
    background: transparent;
    border: 2px solid var(--cat-iznajmljivanje);
  }
  .status[data-status='ideja']::before {
    background: transparent;
    border: 2px dashed var(--muted);
  }

  @media (max-width: 60rem) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
    .head {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 38rem) {
    .row {
      grid-template-columns: 1fr;
      padding-block: 1.5rem;
    }
    .meta div {
      grid-template-columns: 6.5rem 1fr;
    }
  }
</style>
